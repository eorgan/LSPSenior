{
   "name": "lspt-language-support",
   "displayName": "LSPT Language Support",
   "description": "Suporte completo para a linguagem LSP (Linguagem Senior de Programação) com syntax highlighting, snippets, IntelliSense e autocomplete para 640+ funções built-in (incluindo APIs SQL_* de cursor e Http* de requisição)",
   "version": "1.14.0",
   "publisher": "eorgan",
   "author": {
      "name": "Eliezer Organ",
      "email": "eorgan@organ.eti.br"
   },
   "engines": {
      "vscode": "^1.60.0"
   },
   "categories": [
      "Programming Languages",
      "Snippets"
   ],
   "keywords": [
      "lspt",
      "lsp",
      "senior",
      "g5",
      "erp"
   ],
   "repository": {
      "type": "git",
      "url": "https://github.com/eorgan/LSPSenior"
   },
   "license": "MIT",
   "icon": "images/icon.png",
   "main": "./extension.js",
   "activationEvents": [
      "onLanguage:lspt",
      "onCommand:lspt.buscarFuncao",
      "onCommand:lspt.inserirCabecalho"
   ],
   "contributes": {
      "languages": [
         {
            "id": "lspt",
            "aliases": [
               "LSPT",
               "LSP",
               "Linguagem Senior de Programação"
            ],
            "extensions": [
               ".lspt",
               ".lsp"
            ],
            "configuration": "./language-configuration.json",
            "icon": {
               "light": "./icons/lspt-file.svg",
               "dark": "./icons/lspt-file.svg"
            }
         }
      ],
      "grammars": [
         {
            "language": "lspt",
            "scopeName": "source.lspt",
            "path": "./syntaxes/lspt.tmLanguage.json"
         }
      ],
      "snippets": [
         {
            "language": "lspt",
            "path": "./snippets/lspt-snippets.json"
         }
      ],
      "commands": [
         {
            "command": "lspt.buscarFuncao",
            "title": "LSPT: Buscar função no catálogo",
            "category": "LSPT"
         },
         {
            "command": "lspt.inserirCabecalho",
            "title": "LSPT: Inserir cabeçalho",
            "category": "LSPT"
         }
      ],
      "configuration": {
         "title": "LSPT Language Support",
         "properties": {
            "lspt.diagnostics.enabled": {
               "type": "boolean",
               "default": true,
               "description": "Ativa avisos em tempo real das armadilhas da LSP (operação em parâmetro, Pare/Continue fora de loop)."
            },
            "lspt.diagnostics.unknownFunctions": {
               "type": "boolean",
               "default": false,
               "description": "Sinaliza chamadas a funções não encontradas no catálogo (pode gerar falso-positivo com funções do usuário/externas)."
            },
            "lspt.diagnostics.sqlCursorLeak": {
               "type": "boolean",
               "default": true,
               "description": "Avisar quando um cursor SQL_AbrirCursor não for fechado com SQL_FecharCursor ou SQL_Destruir na mesma função."
            },
            "lspt.header.autoUpdate": {
               "type": "boolean",
               "default": true,
               "description": "Atualiza @Last Modified by/time ao salvar arquivos .lspt/.lsp."
            },
            "lspt.header.fallback.author": {
               "type": "string",
               "default": "",
               "description": "Autor usado no cabeçalho quando não há Git configurado (git config user.name)."
            },
            "lspt.header.fallback.email": {
               "type": "string",
               "default": "",
               "description": "E-mail usado no cabeçalho quando não há Git configurado (git config user.email)."
            },
            "lspt.format.indentSize": {
               "type": "integer",
               "default": 3,
               "minimum": 1,
               "maximum": 8,
               "description": "Número de espaços por nível de indentação no Format Document."
            }
         }
      },
      "walkthroughs": [
         {
            "id": "lsptGettingStarted",
            "title": "Primeiros passos com LSPT",
            "description": "Conheça os recursos do LSPT Language Support para a Linguagem Senior.",
            "steps": [
               {
                  "id": "autocomplete",
                  "title": "Autocomplete inteligente",
                  "description": "Complete as 647 funções do catálogo com signature help e hover.",
                  "media": {
                     "markdown": "walkthroughs/01-autocomplete.md"
                  }
               },
               {
                  "id": "buscarFuncao",
                  "title": "Buscar função",
                  "description": "Use \"LSPT: Buscar função\" para inserir a chamada com parâmetros.",
                  "media": {
                     "markdown": "walkthroughs/02-buscar-funcao.md"
                  },
                  "completionEvents": [
                     "onCommand:lspt.buscarFuncao"
                  ]
               },
               {
                  "id": "cabecalho",
                  "title": "Cabeçalho automático",
                  "description": "Insira o cabeçalho preenchido pelo Git e atualizado ao salvar.",
                  "media": {
                     "markdown": "walkthroughs/03-cabecalho.md"
                  },
                  "completionEvents": [
                     "onCommand:lspt.inserirCabecalho"
                  ]
               },
               {
                  "id": "formatterLinter",
                  "title": "Formatter e Linter",
                  "description": "Formate o documento e veja avisos com Quick Fix.",
                  "media": {
                     "markdown": "walkthroughs/04-formatter-linter.md"
                  }
               },
               {
                  "id": "snippets",
                  "title": "Snippets e realce",
                  "description": "62 snippets e gramática de sintaxe da LSP.",
                  "media": {
                     "markdown": "walkthroughs/05-snippets.md"
                  }
               }
            ]
         }
      ]
   },
   "scripts": {
      "package": "vsce package",
      "publish": "ovsx publish"
   },
   "devDependencies": {
      "@vscode/vsce": "^2.19.0",
      "ovsx": "^0.8.0"
   }
}